# SQL Server
DB_SERVER=localhost
DB_NAME=meeting_room_booking
DB_DRIVER=ODBC Driver 18 for SQL Server

# Use Windows authentication locally when available.
DB_TRUSTED_CONNECTION=true
DB_USER=
DB_PASSWORD=

# Keep encryption enabled. TrustServerCertificate may be enabled for local
# development with a self-signed SQL Server certificate only.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Generate a value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
JWT_ISSUER=meeting-room-booking
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Initial administrator created by: python init_db.py
DEFAULT_ADMIN_EMAIL=admin@example.test
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
DEFAULT_ADMIN_NAME=Administrateur

# Comma-separated, without trailing slashes
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business hours
WORK_START_HOUR=8
WORK_END_HOUR=19
